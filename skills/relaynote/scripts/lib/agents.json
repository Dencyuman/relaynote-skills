[
  {
    "id": "codex",
    "name": "Codex",
    "host": "CLI",
    "skillAgent": "codex",
    "delivery": "codex",
    "support": "verified",
    "docs": "https://developers.openai.com/codex/cli/",
    "transcript": {
      "kind": "jsonl",
      "path": "{codex_home}/sessions/*/*/*/rollout-*{thread}*.jsonl",
      "complete": {
        "type": "event_msg",
        "field": "payload.type",
        "equals": [
          "task_complete"
        ]
      },
      "abort": {
        "type": "event_msg",
        "field": "payload.type",
        "equals": [
          "turn_aborted",
          "error"
        ]
      },
      "idFrom": "thread"
    }
  },
  {
    "id": "claude-code",
    "name": "Claude Code",
    "host": "CLI",
    "skillAgent": "claude-code",
    "delivery": "monitor",
    "support": "verified",
    "docs": "https://code.claude.com/docs/en/hooks",
    "transcript": {
      "kind": "jsonl",
      "path": "{home}/.claude/projects/{slug}/{thread}.jsonl",
      "slug": "absolute",
      "complete": {
        "type": "assistant",
        "field": "message.stop_reason",
        "equals": [
          "end_turn",
          "stop_sequence"
        ]
      },
      "abort": {
        "type": "assistant",
        "field": "isApiErrorMessage",
        "equals": [
          true
        ]
      },
      "idFrom": "thread"
    }
  },
  {
    "id": "cursor-cli",
    "name": "Cursor",
    "host": "CLI",
    "skillAgent": "cursor",
    "delivery": "monitor",
    "support": "verified",
    "docs": "https://cursor.com/docs/cli/overview",
    "transcript": {
      "kind": "jsonl",
      "path": "{home}/.cursor/projects/{slug}/agent-transcripts/{thread}/{thread}.jsonl",
      "slug": "relative",
      "complete": {
        "type": "turn_ended",
        "field": "status",
        "equals": [
          "success"
        ]
      },
      "abort": {
        "type": "turn_ended",
        "field": "status",
        "equals": [
          "error",
          "cancelled",
          "aborted"
        ]
      },
      "idFrom": "thread"
    }
  },
